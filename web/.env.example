# Copy to .env. Paths are relative to this application's root, not your username.
DATABASE_URL=postgresql+psycopg://tide:change-this-password@127.0.0.1:55432/tide
# Docker Compose uses the raw password. URL-encode reserved characters in DATABASE_URL only.
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=55432
STORAGE_ROOT=./storage
ANALYZER_ROOT=../tracking
# Leave empty to use the analyzer's own .venv; otherwise use an executable path.
ANALYZER_PYTHON=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Exact API hostnames, without scheme or port; keep local unless you deploy authentication.
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_BYTES=2147483648

# Project AI analysis: disabled, codex (local ChatGPT login), or openai (API billing).
TIDE_AI_PROVIDER=disabled
TIDE_AI_MODEL=
TIDE_AI_TIMEOUT_SECONDS=120
TIDE_AI_RUN_TIMEOUT_SECONDS=240
TIDE_AI_MAX_CONCURRENT=2
# Server-side only. Never use NEXT_PUBLIC_ for credentials.
OPENAI_API_KEY=
